# =============================================
# Frekans - Ortam Değişkenleri
# =============================================
# Bu dosyayı .env olarak kopyala ve düzenle:
#   copy .env.example .env
# =============================================

# SQL Server Bağlantı Bilgileri
# Sunucu adı (SSMS'de gördüğün gibi yaz)
DB_SERVER=localhost
# Port (named instance kullanıyorsan boş bırak)
DB_PORT=1433
DB_DATABASE=FrekansDB

# Kimlik doğrulama:
# Windows Auth kullanmak için DB_USER ve DB_PASSWORD satırlarını YORUM YAPILI bırak
# SQL Auth kullanmak için aşağıdaki satırların başındaki # işaretini kaldır
# DB_USER=sa
# DB_PASSWORD=SenınSıfren123

DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Server Configuration
PORT=3000
NODE_ENV=development
